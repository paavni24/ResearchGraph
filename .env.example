OPENAI_API_KEY=your-api-key
RAG_CHAT_MODEL=gpt-5-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHROMA_PATH=./data/chroma
RAG_COLLECTION=research_papers
RAG_CHUNK_SIZE=350
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=5
RAG_FULLTEXT_PATH=./data/fulltext.sqlite3

# Hybrid retrieval: vector + full-text + graph -> rerank -> cited answer
HYBRID_RERANK_MODEL=gpt-5-mini
HYBRID_ANSWER_MODEL=gpt-5-mini
HYBRID_PER_RETRIEVER=8
HYBRID_CANDIDATE_LIMIT=20
HYBRID_TOP_K=6
HYBRID_RERANK_CHARS=2000
HYBRID_EMBEDDING_COST_PER_MILLION=0.02
HYBRID_INPUT_COST_PER_MILLION=0.25
HYBRID_CACHED_INPUT_COST_PER_MILLION=0.025
HYBRID_OUTPUT_COST_PER_MILLION=2.0

# Knowledge graph (independent of Chroma and embeddings)
KG_EXTRACTION_MODEL=gpt-5-mini
KG_CHUNK_SIZE=1200
KG_CHUNK_OVERLAP=100
KG_WORKERS=3
KG_MAX_RETRIES=4
KG_RETRY_BASE_SECONDS=1.0
KG_STATE_PATH=./data/kg_state.sqlite3
# Defaults below are GPT-5 Mini standard prices; update them when model/pricing changes.
KG_INPUT_COST_PER_MILLION=0.25
KG_CACHED_INPUT_COST_PER_MILLION=0.025
KG_OUTPUT_COST_PER_MILLION=2.0
KG_QUERY_MODEL=gpt-5-mini
KG_RETRIEVAL_DEPTH=3
KG_RETRIEVAL_TOP_K=8
KG_ENTITY_MATCHES=3
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=choose-a-strong-local-password
NEO4J_DATABASE=neo4j
